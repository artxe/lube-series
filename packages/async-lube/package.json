{
	"author": "artxe",
	"bugs": {
		"url": "https://github.com/artxe/lube-series/issues"
	},
	"description": "Syntax sugar for fetch requests, streams, async flows and durable runs",
	"devDependencies": {
		"@typescript/native": "npm:typescript@^7.0.2"
	},
	"engines": { "node": ">=18" },
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./durable": {
			"types": "./types/durable/index.d.ts",
			"default": "./src/durable/index.js"
		}
	},
	"files": [
		"CHANGELOG.md",
		"docs",
		"public.d.ts",
		"src",
		"types/attempt.*",
		"types/durable/index.*",
		"types/durable/state.*",
		"types/durable/store.*",
		"types/errors.*",
		"types/flow/index.*",
		"types/http/index.*",
		"types/index.*",
		"types/limiter.*",
		"types/offload.*",
		"types/stream.*"
	],
	"homepage": "https://github.com/artxe/lube-series/tree/master/packages/async-lube#readme",
	"keywords": [
		"abort",
		"async",
		"async iterator",
		"async-lube",
		"channel",
		"durable",
		"fetch",
		"flow",
		"http",
		"lube",
		"rate limit",
		"retry",
		"server-sent events",
		"stream",
		"websocket",
		"worker",
		"workflow"
	],
	"license": "MIT",
	"main": "src/index.js",
	"name": "async-lube",
	"repository": {
		"directory": "packages/async-lube",
		"type": "git",
		"url": "https://github.com/artxe/lube-series"
	},
	"scripts": {
		"dts": "node ../../scripts/tsc_with_clean.js async-lube",
		"lint": "pnpm -w lint",
		"prepack": "pnpm dts",
		"prepublishOnly": "pnpm -w lint && pnpm test",
		"test": "pnpm -w exec vitest run --coverage test/async-lube && pnpm -w exec vitest run --config vitest.browser.config.js"
	},
	"sideEffects": false,
	"type": "module",
	"types": "types/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [ "types/index.d.ts" ],
			"durable": [ "types/durable/index.d.ts" ]
		}
	},
	"version": "2.0.0"
}