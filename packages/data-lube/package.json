{
	"author": "artxe",
	"bugs": {
		"url": "https://github.com/artxe/lube-series/issues"
	},
	"description": "Simplify Data Manipulation in JavaScript",
	"devDependencies": {
		"@typescript/native": "npm:typescript@^7.0.2"
	},
	"engines": { "node": ">=16" },
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		}
	},
	"files": [
		"CHANGELOG.md",
		"public.d.ts",
		"src",
		"types/deep_*",
		"types/index.*"
	],
	"homepage": "https://github.com/artxe/lube-series/tree/master/packages/data-lube#readme",
	"keywords": [
		"data",
		"data-lube",
		"deep clone",
		"deep copy",
		"deep diff",
		"deep equal",
		"deep freeze",
		"deep merge",
		"deep update",
		"immutable",
		"lube",
		"patch",
		"syntax sugar"
	],
	"license": "MIT",
	"main": "src/index.js",
	"name": "data-lube",
	"repository": {
		"directory": "packages/data-lube",
		"type": "git",
		"url": "https://github.com/artxe/lube-series"
	},
	"scripts": {
		"dts": "node ../../scripts/tsc_with_clean.js data-lube",
		"lint": "pnpm -w lint",
		"prepack": "pnpm dts",
		"prepublishOnly": "pnpm -w lint && pnpm test",
		"test": "pnpm -w exec vitest run --coverage test/data-lube"
	},
	"sideEffects": false,
	"type": "module",
	"types": "types/index.d.ts",
	"typesVersions": {
		"*": { "*": [ "types/index.d.ts" ] }
	},
	"version": "2.0.0"
}